dist/

# Downloaded data and generated evaluation/video artifacts.
/data/
outputs/*
# Results are shared; weights, checkpoints, caches, renders and logs are not.
!outputs/rl/
outputs/rl/**/checkpoints/
outputs/rl/**/resume.pt
outputs/rl/**/*.log
outputs/rl/**/*.err
!outputs/eval/
outputs/eval/*/*
!outputs/eval/*/results.json
!outputs/finetune/
outputs/finetune/*/*
!outputs/finetune/*/model/
outputs/finetune/*/model/*.pt

# Local credentials, editor settings, and OS metadata.
.env
.env.*
!.env.example
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db
desktop.ini
